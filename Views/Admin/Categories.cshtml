@model IEnumerable<NouvoStudio.Models.Category>
@{
    ViewData["Title"] = "Categories — Admin Panel";
    ViewData["Page"] = "admin";
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSideBar" />

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 admin-content p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Categories</h2>
                <a asp-action="CreateCategory" class="btn btn-primary">
                    <i class="bi bi-plus"></i> Add Category
                </a>
            </div>
            
            <div class="row g-3">
                @foreach (var category in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card">
                            <img src="@category.Image" class="card-img-top" alt="@category.Name" style="height: 200px; object-fit: cover;">
                            <div class="card-body">
                                <h5 class="card-title">@category.Name</h5>
                                <p class="card-text text-muted">@(category.Description ?? "No description")</p>
                                <div class="d-flex gap-2">
                                    <a asp-action="EditCategory" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="DeleteCategory" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h3 class="text-muted">No categories found</h3>
                    <p class="text-muted">Add your first category to get started.</p>
                    <a asp-action="CreateCategory" class="btn btn-primary">Add Category</a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .admin-sidebar { min-height: 100vh; background: #f8f9fa; }
    .admin-content { min-height: 100vh; }
</style>
