@model NouvoStudio.Models.Spaces
@{
    ViewData["Title"] = "Delete Space — Admin Panel";
    ViewData["Page"] = "admin";
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSideBar" />

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 admin-content p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Delete Space</h2>
                <a asp-action="Spaces" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Spaces
                </a>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div class="alert alert-warning">
                        <h5><i class="bi bi-exclamation-triangle"></i> Are you sure you want to delete this Space?</h5>
                        <p>This action cannot be undone. All artworks in this Space will also be deleted.</p>
                    </div>

                    <div class="card">
                        <img src="@Model.Image" class="card-img-top" alt="@Model.Name" style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title">@Model.Name</h5>
                            <p class="card-text">@(Model.Description ?? "No description")</p>
                        </div>
                    </div>

                    <form asp-action="DeleteSpaces" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete Space
                        </button>
                        <a asp-action="Spaces" class="btn btn-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-sidebar {
        min-height: 100vh;
        background: #f8f9fa;
    }

    .admin-content {
        min-height: 100vh;
    }
</style>
