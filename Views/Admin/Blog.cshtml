@model IEnumerable<NouvoStudio.Models.BlogPost>
@{
    ViewData["Title"] = "Blog — Admin Panel";
    ViewData["Page"] = "admin";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSideBar" />

        <div class="col-md-9 col-lg-10 admin-content p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Blog Posts</h2>
                <a asp-action="CreatePost" class="btn btn-primary">
                    <i class="bi bi-plus"></i> New Post
                </a>
            </div>

            <div class="row g-3">
                @foreach (var post in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100">
                            <img src="@post.Image" class="card-img-top" alt="@post.Title" style="height: 180px; object-fit: cover;">
                            <div class="card-body">
                                <div class="fw-semibold">@post.Title</div>
                                <div class="text-muted small mb-2">@post.PublishedAt.ToString("MMM dd, yyyy")</div>
                                <p class="small">@post.Excerpt</p>
                                <div class="d-flex gap-2">
                                    <a asp-action="EditPost" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="DeletePost" asp-route-id="@post.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h3 class="text-muted">No posts yet</h3>
                    <a asp-action="CreatePost" class="btn btn-primary">Create your first post</a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .admin-sidebar { min-height: 100vh; background: #f8f9fa; }
    .admin-content { min-height: 100vh; }
</style>


