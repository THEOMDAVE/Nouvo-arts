@model IEnumerable<NouvoStudio.Models.Spaces>
@{
    ViewData["Title"] = "Spaces — Admin Panel";
    ViewData["Page"] = "admin";
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSideBar" />

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 admin-content p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Explore By Spaces</h2>
                <a asp-action="CreateSpaces" class="btn btn-primary">
                    <i class="bi bi-plus"></i> Add Space
                </a>
            </div>

            <div class="row g-3">
                @foreach (var space in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card">
                            <img src="@space.Image" class="card-img-top" alt="@space.Name" style="height: 200px; object-fit: cover;">
                            <div class="card-body">
                                <h5 class="card-title">@space.Name</h5>
                                <p class="card-text text-muted">@(space.Description ?? "No description")</p>
                                <div class="d-flex gap-2">
                                    <a asp-action="EditSpaces" asp-route-id="@space.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="DeleteSpaces" asp-route-id="@space.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h3 class="text-muted">No Spaces found</h3>
                    <p class="text-muted">Add your first space to get started.</p>
                    <a asp-action="CreateSpaces" class="btn btn-primary">Add Space</a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .admin-sidebar {
        min-height: 100vh;
        background: #f8f9fa;
    }

    .admin-content {
        min-height: 100vh;
    }
</style>
