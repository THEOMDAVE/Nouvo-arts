@model NouvoStudio.Models.Medium
@{
    ViewData["Title"] = "Delete Medium — Admin Panel";
    ViewData["Page"] = "admin";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSideBar" />
        <div class="col-md-9 col-lg-10 admin-content p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Delete Medium</h2>
                <a asp-action="Mediums" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Mediums
                </a>
            </div>

            <div class="alert alert-warning">
                Are you sure you want to delete the medium "<strong>@Model.Name</strong>"?
            </div>

            <form asp-action="DeleteMedium" method="post">
                <input asp-for="Id" type="hidden" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Mediums" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>




