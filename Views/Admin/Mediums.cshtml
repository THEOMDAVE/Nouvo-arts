@model IEnumerable<NouvoStudio.Models.Medium>
@{
    ViewData["Title"] = "Mediums — Admin Panel";
    ViewData["Page"] = "admin";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSideBar" />
        <div class="col-md-9 col-lg-10 admin-content p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Mediums</h2>
                <a asp-action="CreateMedium" class="btn btn-primary">
                    <i class="bi bi-plus"></i> Add Medium
                </a>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var medium in Model)
                        {
                            <tr>
                                <td>@medium.Name</td>
                                <td class="text-end">
                                    <a asp-action="EditMedium" asp-route-id="@medium.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="DeleteMedium" asp-route-id="@medium.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h3 class="text-muted">No mediums yet</h3>
                </div>
            }
        </div>
    </div>
</div>




