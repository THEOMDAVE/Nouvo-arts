@model IEnumerable<NouvoStudio.Models.CustomizationRequest>
@{
    ViewData["Title"] = "Customization Requests — Admin Panel";
    ViewData["Page"] = "admin";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSideBar" />
        <div class="col-md-9 col-lg-10 admin-content p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Customization Requests</h2>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Artwork Type</th>
                            <th>Medium</th>
                            <th>Size</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            <tr class="@(!request.IsRead ? "table-warning" : "")">
                                <td>@request.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@request.Name</td>
                                <td>@request.Email</td>
                                <td>@request.ArtworkType</td>
                                <td>@request.Medium</td>
                                <td>@request.Size</td>
                                <td class="text-end">
                                    <a asp-action="CustomizationDetails" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">View</a>
                                    <form asp-action="DeleteCustomization" asp-route-id="@request.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this customization request?');">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h3 class="text-muted">No customization requests yet</h3>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .admin-sidebar { min-height: 100vh; background: #f8f9fa; }
    .admin-content { min-height: 100vh; }
</style>

