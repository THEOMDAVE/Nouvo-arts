@model IEnumerable<NouvoStudio.Models.Artwork>
@{
    ViewData["Title"] = "Artworks — Admin Panel";
    ViewData["Page"] = "admin";
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSideBar" />

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 admin-content p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Artworks</h2>
                <a asp-action="CreateArtwork" class="btn btn-primary">
                    <i class="bi bi-plus"></i> Add Artwork
                </a>
            </div>
            
            <div class="row g-3">
                @foreach (var artwork in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card">
                            <img src="@($"{artwork.Image}.webp")" class="card-img-top" alt="@artwork.Name" style="height: 200px; object-fit: cover;">
                            <div class="card-body">
                                <h5 class="card-title">@artwork.Name</h5>
                                <p class="card-text">
                                    <small class="text-muted">@artwork.Code • @artwork.Size • @artwork.Medium</small><br>
                                    <small class="text-muted">Size: @artwork.HeightFeet in X @artwork.WidthFeet in</small><br>
                                    @if (artwork.Price.HasValue)
                                    {
                                        <span class="text-primary fw-semibold">$@artwork.Price.Value.ToString("F0")</span>
                                    }
                                    @* else
                                    {
                                        <span class="text-muted">Price not set</span>
                                    } *@
                                </p>
                                <p class="card-text small">@(artwork.Description ?? "No description")</p>
                                <div class="d-flex gap-2">
                                    <a asp-action="EditArtwork" asp-route-id="@artwork.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="DeleteArtwork" asp-route-id="@artwork.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h3 class="text-muted">No artworks found</h3>
                    <p class="text-muted">Add your first artwork to get started.</p>
                    <a asp-action="CreateArtwork" class="btn btn-primary">Add Artwork</a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .admin-sidebar { min-height: 100vh; background: #f8f9fa; }
    .admin-content { min-height: 100vh; }
</style>
