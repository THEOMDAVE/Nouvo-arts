        // Auto-update Size field based on dimensions
        document.addEventListener('DOMContentLoaded', function () {
            const heightInput = document.querySelector('input[name="HeightFeet"]');
            const widthInput = document.querySelector('input[name="WidthFeet"]');
            const sizeInput = document.querySelector('input[name="Size"]');

            function updateSize() {
                const height = parseFloat(heightInput.value) || 0;
                const width = parseFloat(widthInput.value) || 0;

                if (height > 0 && width > 0) {
                    const area = height * width;

                    let category = "";
                    if (area <= 400) category = "Small";
                    else if (area <= 900) category = "Medium";
                    else if (area <= 1600) category = "Large";
                    else category = "ExtraLarge";

                    // Save result into Size field (example: "20 X 20 (Small)")
                    sizeInput.value = `${height} X ${width} (${category})`;
                } else {
                    sizeInput.value = "";
                }
            }

            if (heightInput && widthInput && sizeInput) {
                heightInput.addEventListener('input', updateSize);
                widthInput.addEventListener('input', updateSize);
                updateSize();
            }
        });

    </script>
}


