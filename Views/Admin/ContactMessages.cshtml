@model IEnumerable<NouvoStudio.Models.ContactMessage>
@{
    ViewData["Title"] = "Contact Messages — Admin Panel";
    ViewData["Page"] = "admin";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSideBar" />
        <div class="col-md-9 col-lg-10 admin-content p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Contact Messages</h2>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Subject</th>
                            <th>Interested Codes</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td>@m.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@m.Name</td>
                                <td>@m.Email</td>
                                <td>@m.Subject</td>
                                <td>@(string.IsNullOrWhiteSpace(m.InterestedCodes) ? "-" : m.InterestedCodes)</td>
                                <td class="text-end">
                                    <a asp-action="ContactMessageDetails" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">View</a>
                                    <form asp-action="DeleteContactMessage" asp-route-id="@m.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h3 class="text-muted">No messages yet</h3>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .admin-sidebar { min-height: 100vh; background: #f8f9fa; }
    .admin-content { min-height: 100vh; }
</style>


