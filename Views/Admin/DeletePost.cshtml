@model NouvoStudio.Models.BlogPost
@{
    ViewData["Title"] = "Delete Post — Admin Panel";
    ViewData["Page"] = "admin";
}

<div class="container py-5">
    <h2>Delete Post</h2>
    <p>Are you sure you want to delete <strong>@Model.Title</strong>?</p>
    <form asp-action="DeletePost" method="post">
        <input asp-for="Id" type="hidden" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Blog" class="btn btn-secondary">Cancel</a>
    </form>
</div>


