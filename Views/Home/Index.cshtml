@{
    ViewData["Title"] = "Nouvo Studio — Contemporary Art, Artists, and Artworks";
    ViewData["Page"] = "home";
}

<!-- Hero / Landing -->
<header class="hero d-flex align-items-center position-relative">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="container position-relative">
        <div class="row justify-content-center text-center">
            <div class="col-11 col-md-10 col-lg-8">
                <h1 class="display-3 fw-bold hero-title">Nouvo Studio</h1>
                <p class="lead mt-3 hero-subtitle">Beyond the seen.</p>
            </div>
        </div>
    </div>
</header>

<!-- Explore By Spaces - Netflix Style Carousel -->
<section class="py-6 netflix-carousel-section" >
    <div class="container-fluid px-md-4">
        <div class="d-flex align-items-end justify-content-center mb-4 px-3 px-md-0">
            <h2 class="section-title m-0">
                <a asp-controller="Spaces" asp-action="Index" class="link-dark text-decoration-none">Explore By Spaces</a>
            </h2>
        </div>
        
        <div class="netflix-carousel-wrapper position-relative">
            <button class="netflix-carousel-btn netflix-carousel-btn-prev" aria-label="Previous" type="button">
                <i class="bi bi-chevron-left"></i>
            </button>
            
            <div class="netflix-carousel-container" id="spacesCarousel">
                <div class="netflix-carousel-track">
                    @if (ViewBag.Spaces != null)
                    {
                        var spaces = (IEnumerable<NouvoStudio.Models.Spaces>)ViewBag.Spaces;
                        @foreach (var space in spaces)
                        {
                            <div class="netflix-carousel-item">
                                <a asp-controller="Artworks" asp-action="Index" asp-route-category="@space.Id" class="text-decoration-none">
                                    <div class="netflix-card">
                                        <div class="netflix-card-image-wrapper">
                                            <img class="netflix-card-image" src="@space.Image" alt="@space.Name" loading="lazy">
                                        </div>
                                        <div class="netflix-card-overlay">
                                            <div class="netflix-card-title">@space.Name</div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
            
            <button class="netflix-carousel-btn netflix-carousel-btn-next" aria-label="Next" type="button">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</section>


<!-- Featured Artworks Carousel -->
<section id="featured" class="py-6 bg-light">
    <div class="container" style="--bs-gutter-x: 1px !important; max-width: 100% !important;">
        <div class="d-flex align-items-end justify-content-center mb-4 px-3 px-md-0">
            <h2 class="section-title m-0"> <a asp-controller="Artworks" asp-action="Index" class="link-dark text-decoration-none">Featured Artworks</a> </h2>
        </div>

        <div id="featuredCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="2000">
            <div class="carousel-inner" id="featuredCarouselInner">
                @if (ViewBag.FeaturedArtworks != null)
                {
                    var featuredArtworks = (IEnumerable<NouvoStudio.Models.Artwork>)ViewBag.FeaturedArtworks;
                    var first = true;
                    @foreach (var artwork in featuredArtworks)
                    {
                        <div class="carousel-item @(first ? "active" : "")">
                            <img src="@artwork.Image" class="d-block w-100 featured-carousel-image" alt="@artwork.Name" loading="lazy">
                            <div class="carousel-caption d-none d-md-block">
                                <h5>@artwork.Name</h5>
                                <p>@artwork.Size • @artwork.Medium</p>
                            </div>
                        </div>
                        first = false;
                    }
                }
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#featuredCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>

            <button class="carousel-control-next" type="button" data-bs-target="#featuredCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
</section>


@section Scripts {
    <script>
        // Smooth scrolling for anchor links
        document.querySelectorAll('.smooth-anchor').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });

        // Netflix Style Carousel Navigation
        (function() {
            const carouselWrapper = document.querySelector('.netflix-carousel-wrapper');
            if (!carouselWrapper) return;

            const carousel = document.getElementById('spacesCarousel');
            if (!carousel) return;

            const track = carousel.querySelector('.netflix-carousel-track');
            const prevBtn = carouselWrapper.querySelector('.netflix-carousel-btn-prev');
            const nextBtn = carouselWrapper.querySelector('.netflix-carousel-btn-next');
            const items = track.querySelectorAll('.netflix-carousel-item');
            
            if (!track || !prevBtn || !nextBtn || items.length === 0) return;

            let currentPosition = 0;
            
            function getScrollAmount() {
                if (items.length === 0) return 0;
                const itemWidth = items[0].offsetWidth;
                const gap = window.innerWidth < 768 ? 8 : 12;
                // On desktop (>=992px): scroll 1 item at a time to show next set
                // On tablet: scroll 1 item
                // On mobile: scroll 1 item
                const itemsToScroll = 1;
                return (itemWidth + gap) * itemsToScroll;
            }

            // Calculate max scroll position
            function getMaxScroll() {
                const trackWidth = track.scrollWidth;
                const containerWidth = carousel.offsetWidth;
                return Math.max(0, trackWidth - containerWidth);
            }

            // Scroll function
            function scroll(direction) {
                const maxScroll = getMaxScroll();
                const scrollAmount = getScrollAmount();
                
                if (direction === 'next') {
                    if (currentPosition >= maxScroll) {
                        // wrap to start
                        currentPosition = 0;
                    } else {
                        currentPosition = Math.min(currentPosition + scrollAmount, maxScroll);
                    }
                } else {
                    if (currentPosition <= 0) {
                        // wrap to end
                        currentPosition = maxScroll;
                    } else {
                        currentPosition = Math.max(currentPosition - scrollAmount, 0);
                    }
                }

                track.style.transform = `translateX(-${currentPosition}px)`;
            }

            // Button event listeners
            nextBtn.addEventListener('click', () => scroll('next'));
            prevBtn.addEventListener('click', () => scroll('prev'));

            // Touch/swipe support for mobile
            let isDown = false;
            let startX;
            let scrollLeft;

            track.addEventListener('mousedown', (e) => {
                isDown = true;
                startX = e.pageX - track.offsetLeft;
                scrollLeft = currentPosition;
                track.style.cursor = 'grabbing';
            });

            track.addEventListener('mouseleave', () => {
                isDown = false;
                track.style.cursor = 'grab';
            });

            track.addEventListener('mouseup', () => {
                isDown = false;
                track.style.cursor = 'grab';
            });

            track.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                e.preventDefault();
                const x = e.pageX - track.offsetLeft;
                const walk = (x - startX) * 2;
                let newPosition = scrollLeft - walk;
                const maxScroll = getMaxScroll();
                if (newPosition < 0) {
                    newPosition = maxScroll;
                } else if (newPosition > maxScroll) {
                    newPosition = 0;
                }
                currentPosition = newPosition;
                track.style.transform = `translateX(-${currentPosition}px)`;
            });

            // Touch events
            let touchStartX = 0;
            let touchStartY = 0;

            track.addEventListener('touchstart', (e) => {
                touchStartX = e.touches[0].clientX;
                touchStartY = e.touches[0].clientY;
            }, { passive: true });

            track.addEventListener('touchmove', (e) => {
                if (!touchStartX) return;
                
                const touchX = e.touches[0].clientX;
                const touchY = e.touches[0].clientY;
                const diffX = touchStartX - touchX;
                const diffY = touchStartY - touchY;

                // Only prevent default if horizontal scroll is greater
                if (Math.abs(diffX) > Math.abs(diffY)) {
                    e.preventDefault();
                    const maxScroll = getMaxScroll();
                    let newPosition = currentPosition + diffX;
                    if (newPosition < 0) {
                        newPosition = maxScroll;
                    } else if (newPosition > maxScroll) {
                        newPosition = 0;
                    }
                    currentPosition = newPosition;
                    track.style.transform = `translateX(-${currentPosition}px)`;
                }
            }, { passive: false });

            track.addEventListener('touchend', () => {
                touchStartX = 0;
                touchStartY = 0;
            });

            // Handle window resize
            let resizeTimer;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(() => {
                    currentPosition = 0;
                    track.style.transform = `translateX(0)`;
                }, 250);
            });

            // Initialize
            track.style.cursor = 'grab';
        })();
    </script>
}