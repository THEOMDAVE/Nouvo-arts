@model IEnumerable<Artwork>

@foreach (var artwork in Model)
{
    <div class="masonry-item">
        <div class="art-card shadow-sm">
            <a asp-controller="Artworks" asp-action="Details" asp-route-id="@artwork.Id" class="text-decoration-none text-dark">

                <img src="@artwork.Image" class="img-fluid w-100" alt="@artwork.Name" loading="lazy" decoding="async" />

                <div class="overlay p-3">
                    <h6 class="fw-semibold mb-1">@artwork.Name</h6>
                    <small>@artwork.Code</small>
                </div>
            </a>
        </div>
    </div>
}
