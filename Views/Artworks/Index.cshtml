@model IEnumerable<NouvoStudio.Models.Artwork>
@{
    ViewData["Title"] = "Artworks — Nouvo Art";
    ViewData["Page"] = "artworks";
    var mediums = ViewBag.Mediums as IEnumerable<NouvoStudio.Models.Medium>;

    var totalPages = (int)Math.Ceiling((double)ViewBag.TotalCount / ViewBag.PageSize);

    var names = ViewBag.Name ?? "";
}

<main class="py-5">
    <div class="container">
       
        <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">

            <!-- Left Side Title -->
            <div>
                <h1 class="section-title m-0">Artworks </h1>
                <div class="text-muted" id="artworksCount">@ViewBag.TotalCount Artworks @(!string.IsNullOrWhiteSpace(names) ? "From " + names: "")</div>
            </div>

            <!-- Right Side Filters -->
            <form id="filterForm" method="get" class="w-75 w-lg-auto d-flex flex-wrap gap-2">

                <!-- Search -->
                <div class="flex-grow-1">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text"
                               name="search"
                               value="@ViewBag.SearchQuery"
                               class="form-control"
                               placeholder="Search..."
                               oninput="autoFilter()">
                    </div>
                </div>
                <!-- Size -->
                <div>
                    <select name="size" class="form-select" onchange="autoFilter()">
                        <option value="">All sizes</option>
                        <option value="Small" selected="@(ViewBag.SelectedSize == "Small")">Small</option>
                        <option value="Medium" selected="@(ViewBag.SelectedSize == "Medium")">Medium</option>
                        <option value="Large" selected="@(ViewBag.SelectedSize == "Large")">Large</option>
                    </select>
                </div>

                <!-- Medium -->
                <div>
                    <select name="medium" class="form-select" onchange="autoFilter()">
                        <option value="">All mediums</option>
                        @if (mediums != null)
                        {
                            @foreach (var medium in mediums)
                            {
                                <option value="@medium.Name" selected="@(ViewBag.SelectedMedium == medium.Name)">@medium.Name</option>
                            }
                        }
                    </select>
                </div>
            </form>
        </div>

        @* <div class="masonry-container" id="artworksGrid"> *@
           @*  <div id="artworksGrid">

                @await Html.PartialAsync("_ArtworkGrid", Model)
            
        
        </div> *@
      <div id="artworksGrid">
    @await Html.PartialAsync("_ArtworkGrid", Model)
</div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h3 class="text-muted">No artworks found</h3>
                <p class="text-muted">Try adjusting your search criteria or browse all categories.</p>
            </div>
        }
    </div>
</main>

<!-- Artwork Modal -->
<div class="modal fade" id="artworkModal" tabindex="-1" aria-labelledby="artworkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-body p-0">
                <div class="row g-0">
                    <div class="col-lg-7">
                        <img id="modalImage" class="img-fluid w-100 h-100 object-fit-cover" alt="Artwork image">
                    </div>
                    <div class="col-lg-5 p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 id="modalTitle" class="mb-1"></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="text-muted" id="modalCode"></div>
                        <div class="mt-3 small">
                            <div><span class="text-muted">Size:</span> <span id="modalSize"></span></div>
                            <div><span class="text-muted">Medium:</span> <span id="modalMedium"></span></div>
                        </div>
                        <p class="mt-3" id="modalDescription"></p>
                        <div class="h5" id="modalPrice" hidden></div>
                        <div class="mt-3 p-3 bg-light rounded">
                            <div class="fw-semibold mb-1">Do you like it?</div>
                            <div>Want to place an order? Call <a href="tel:+1234567890" class="link-dark fw-semibold">+1 234 567 890</a>.</div>
                        </div>
                        <button id="modalFavoriteBtn" class="btn btn-outline-dark mt-3"><i class="bi bi-heart"></i> Add to Favorites</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let page = 1;
    let loading = false;

    const grid = document.querySelector('#artworksGrid');
    let msnry;

    // Initialize Masonry after images load
    imagesLoaded(grid, function () {
        msnry = new Masonry(grid, {
            itemSelector: '.masonry-item',
            percentPosition: true
        });
    });

    window.addEventListener("scroll", function () {

        if (loading) return;

        if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 300) {

            loading = true;
            page++;

            const params = new URLSearchParams();
            params.append("page", page);

            fetch('@Url.Action("Index", "Artworks")?' + params.toString(), {
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            })
            .then(res => res.text())
            .then(html => {

                if (html.trim() === "") return;

                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;

                const newItems = tempDiv.querySelectorAll('.masonry-item');

                newItems.forEach(item => grid.appendChild(item));

                imagesLoaded(grid, function () {
                    msnry.appended(newItems);
                    msnry.layout();
                });

                loading = false;
            });
        }
    });
</script>
