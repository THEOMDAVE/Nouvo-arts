@model ArtworkListViewModel
@{
    ViewData["Title"] = "Artworks — Nouvo Art";
    ViewData["Page"] = "artworks";
    var mediums = Model.Mediums;
    

}
<style>
    
    /* Artwork fade-in animation */
    .fade-item {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.5s ease, transform 0.5s ease;
    }

        .fade-item.show {
            opacity: 1;
            transform: translateY(0);
        }

</style>

<main class="py-5">
    <div class="container">
       
        <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">

            <!-- Left Side Title -->
            <div>
                <h1 class="section-title m-0">Artworks </h1>
                <div class="text-muted">
                    @Model.TotalCount Artworks
                    @if (!string.IsNullOrWhiteSpace(Model.Name))
                    {
                        <span>From <strong>@Model.Name</strong></span>
                    }
                </div>


            </div>

            <!-- Right Side Filters -->
            <form id="filterForm" method="get" class="w-75 w-lg-auto d-flex flex-wrap gap-2">

                <!-- Search -->
                <div class="flex-grow-1">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text"
                               name="search"
                               value="@Model.SearchQuery"
                               class="form-control"
                               placeholder="Search..."
                               oninput="autoFilter()">
                    </div>
                </div>
                <!-- Size -->
                <div>
                    <select name="size" class="form-select" onchange="autoFilter()">
                        <option value="">All sizes</option>
                        <option value="Small" selected="@(Model.SelectedSize == "Small")">Small</option>
                        <option value="Medium" selected="@(Model.SelectedSize == "Medium")">Medium</option>
                        <option value="Large" selected="@(Model.SelectedSize == "Large")">Large</option>
                    </select>
                </div>

                <!-- Medium -->
                <div>
                    <select name="medium" class="form-select" onchange="autoFilter()">
                        <option value="">All mediums</option>
                        @if (mediums != null)
                        {
                            @foreach (var medium in mediums)
                            {
                                <option value="@medium.Name" selected="@(Model.SelectedMedium == medium.Name)">@medium.Name</option>
                            }
                        }
                    </select>
                </div>
            </form>
        </div>

@* 
        <div id="artworksGrid" class="row-masonry">
            @await Html.PartialAsync("_ArtworkGrid", Model.Artworks)
        </div> *@
        <div id="artworksGrid">
            <div class="grid-sizer"></div>
            @await Html.PartialAsync("_ArtworkGrid", Model.Artworks)
        </div>

        <div id="loadingSpinner" class="text-center py-4" style="display:none;">
            <div class="spinner-border text-dark" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>

        @* <div id="loadingSpinner" class="text-center py-4 d-none">
            <div class="spinner-border text-dark" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div> *@


        @if (!(Model.Artworks?.Any() ?? false))
        {
            <div class="text-center py-5">
                <h3 class="text-muted">No artworks found</h3>
                <p class="text-muted">
                    Try adjusting your search criteria or browse all categories.
                </p>
            </div>
        }
    </div>
</main>

<!-- Artwork Modal -->
<div class="modal fade" id="artworkModal" tabindex="-1" aria-labelledby="artworkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-body p-0">
                <div class="row g-0">
                    <div class="col-lg-7">
                        <img id="modalImage" class="img-fluid w-100 h-100 object-fit-cover" alt="Artwork image">
                    </div>
                    <div class="col-lg-5 p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 id="modalTitle" class="mb-1"></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="text-muted" id="modalCode"></div>
                        <div class="mt-3 small">
                            <div><span class="text-muted">Size:</span> <span id="modalSize"></span></div>
                            <div><span class="text-muted">Medium:</span> <span id="modalMedium"></span></div>
                        </div>
                        <p class="mt-3" id="modalDescription"></p>
                        <div class="h5" id="modalPrice" hidden></div>
                        <div class="mt-3 p-3 bg-light rounded">
                            <div class="fw-semibold mb-1">Do you like it?</div>
                            <div>Want to place an order? Call <a href="tel:+1234567890" class="link-dark fw-semibold">+1 234 567 890</a>.</div>
                        </div>
                        <button id="modalFavoriteBtn" class="btn btn-outline-dark mt-3"><i class="bi bi-heart"></i> Add to Favorites</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
     let masonry;

    document.addEventListener("DOMContentLoaded", function () {

        const grid = document.querySelector('#artworksGrid');

        masonry = new Masonry(grid, {
            itemSelector: '.masonry-item',
            columnWidth: '.grid-sizer',   // 🔥 THIS LINE
            percentPosition: true
        });

        imagesLoaded(grid).on('progress', function () {
            masonry.layout();
        });

    });

    let page = @Model.Page;
    let loading = false;
    let noMoreData = false;

    const spinner = document.getElementById("loadingSpinner");

    window.addEventListener("scroll", async () => {

        if (loading || noMoreData) return;

        if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 1000) {

            loading = true;
            spinner.style.display = "block";// ✅ Fade in spinner
            page++;

            const params = new URLSearchParams({
                page: page,
                categoryId: "@(Model.SelectedCategoryId?.ToString() ?? "")",
                spaceId: "@(Model.SelectedSpaceId?.ToString() ?? "")",
                search: "@(Model.SearchQuery ?? "")",
                size: "@(Model.SelectedSize ?? "")",
                medium: "@(Model.SelectedMedium ?? "")"
            });

            const response = await fetch('@Url.Action("Index", "Artworks")?' + params, {
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });

            const html = await response.text();

            const temp = document.createElement("div");
            temp.innerHTML = html;

            const newItems = temp.querySelectorAll(".masonry-item");

            if (!newItems.length) {
                noMoreData = true;
                spinner.style.display = "none";
                return;
            }

                const grid = document.querySelector('#artworksGrid');

            newItems.forEach(item => {
                item.classList.add("fade-item");
                grid.appendChild(item);
            });

            imagesLoaded(newItems, function () {

                masonry.appended(newItems);   // 🔥 Tell Masonry new items added
                masonry.layout();             // 🔥 Recalculate positions

                newItems.forEach((item, index) => {
                    setTimeout(() => {
                        item.classList.add("show");
                    }, index * 80);
                });

            });


            spinner.style.display = "none"; // ✅ Fade out spinner
            loading = false;
        }
    });
</script>
